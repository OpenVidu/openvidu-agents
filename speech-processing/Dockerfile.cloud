# syntax=docker/dockerfile:1
# Dockerfile for cloud-based STT providers

ARG BASE_IMAGE=openvidu/agent-speech-processing-base:main

# =============================================================================
# STAGE 1: builder - install the Python dependencies into /opt/venv
# =============================================================================
FROM ${BASE_IMAGE} AS builder

# git: pip installs openviduagentutils from GitHub, and patches/apply.sh uses
# "git apply". gcc/g++: packages without a prebuilt wheel for this platform.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    gcc \
    g++ \
  && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy cloud requirements and install dependencies
COPY requirements-base.txt requirements-cloud.txt ./
RUN pip install --no-cache-dir -r requirements-cloud.txt

# TODO: apply the pending upstream fixes to the installed livekit-agents (see patches/apply.sh)
# Remove these two lines below (with folder speech-processing/patches) whenever the livekit-agents
# dependency in use includes https://github.com/livekit/agents/pull/7225
COPY patches ./patches
RUN ./patches/apply.sh && rm -rf ./patches

# The runtime image installs nothing: drop pip (and the copies of urllib3,
# msgpack, certifi and pkg_resources it vendors) from the virtualenv
RUN pip uninstall -y pip

# =============================================================================
# STAGE 2: final - base image + virtualenv, no build tools
# =============================================================================
FROM ${BASE_IMAGE}

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Pre-download any ML models or files the agent needs
# This ensures the container is ready to run immediately without downloading
# dependencies at runtime, which improves startup time and reliability
RUN python main.py download-files

# Change ownership of all app files to the non-privileged user
# This ensures the application can read/write files as needed
RUN chown -R appuser:appuser /app

# Switch to the non-privileged user for all subsequent operations
# This improves security by not running as root
USER appuser

# After downloading, run in offline mode at runtime
ENV HF_HUB_OFFLINE=1

# Run the application
# The "start" command tells the worker to connect to LiveKit and begin waiting for jobs.
CMD ["python", "main.py", "start"]
