{
  "name": "openvidu-agents-e2e-tests",
  "version": "1.0.0",
  "scripts": {
    "test:e2e": "playwright test --project=livecaptions --project=livecaptions-processing-dispatch --project=livecaptions-wrong-license",
    "test:e2e:memory": "playwright test --project=livecaptions-memory-usage",
    "test:e2e:gpu": "STT_ACCEL=cuda12 playwright test --project=livecaptions --grep sherpa",
    "test:e2e:memory:gpu": "STT_ACCEL=cuda12 playwright test --project=livecaptions-memory-usage --grep sherpa",
    "capacity:headless": "ts-node --transpile-only capacity/headless-capacity-probe.ts",
    "capacity:agent-host": "ts-node --transpile-only capacity/agent-host.ts",
    "capacity:summarize": "ts-node --transpile-only capacity/summarize-run.ts"
  },
  "devDependencies": {
    "@livekit/rtc-node": "^1.2.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "26.6.6",
    "fast-levenshtein": "^3.0.0",
    "livekit-server-sdk": "^2.19.3",
    "playwright-ctrf-json-reporter": "^0.2.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
